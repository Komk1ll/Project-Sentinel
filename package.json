{
  "name": "project-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "Project Sentinel - Isometric browser game built with Phaser, Three.js, HTML5, and TypeScript",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:models": "vite-node scripts/generate-sample-models.ts"
  },
  "dependencies": {
    "phaser": "^3.88.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vitest": "^2.1.5"
  }
}
